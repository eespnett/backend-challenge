{
  "name": "distributed-wagering-processor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.x"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit test/smoke",
    "test:smoke": "bun test test/smoke",
    "test:integration": "bun test test/integration --timeout 30000",
    "test:concurrency": "bun test test/concurrency --timeout 30000",
    "test:messaging": "bun test test/integration/phase6-messaging.test.ts test/concurrency/phase6-sqs-processes.test.ts --timeout 30000",
    "test:outbox": "bun test test/unit/outbox.test.ts test/integration/phase7-outbox.test.ts test/concurrency/phase7-outbox-crashes.test.ts --timeout 30000",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "migration:list": "bun scripts/migrate.ts list",
    "check:infra": "bun scripts/check-infrastructure.ts",
    "seed": "bun scripts/seed.ts",
    "send-wager": "bun scripts/send-wager.ts",
    "verify": "bun scripts/verify.ts",
    "test:crash": "bun test test/concurrency/phase5-pending-workers.test.ts test/concurrency/phase6-sqs-processes.test.ts test/concurrency/phase7-outbox-crashes.test.ts --timeout 30000",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "compose:up": "docker compose up -d --build --wait app"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.922.0",
    "@mikro-orm/core": "6.5.8",
    "@mikro-orm/migrations": "6.5.8",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.5.8",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/bun": "1.3.3",
    "typescript": "5.9.3"
  }
}
